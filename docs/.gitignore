# ------------------------------
npm-debug.log
yarn-error.log
*.log
*.cache
.phpunit.result.cache
.php-cs-fixer.cache
build/docs/cache/
cache/

# ------------------------------
# Ambiente e configurazione
# ------------------------------
.env
.env.*
!.env.example
storage/*.key

# ------------------------------
# Build e distribuzioni
# ------------------------------
build
/build/

# ------------------------------
# Laravel specifico
# ------------------------------
# Laravel 4
bootstrap/compiled.php
app/storage/

# Laravel 5+
public/storage
public/hot
public_html/storage
public_html/hot

# ------------------------------
# Homestead
# ------------------------------
Homestead.yaml
Homestead.json
/.vagrant

# ------------------------------
# Documentazione
# ------------------------------
/docs/
docs/phpstan/

# ------------------------------
# Git
# ------------------------------
.git-blame-ignore-revs
.git-rewrite/

# ------------------------------
