# ------------------------------
/vendor/
vendor/
vendor
/vendor
/node_modules/
node_modules/
node_modules
*.phar
*.lock
/*.lock
composer.lock
package-lock.json
/docs/package-lock.json
yarn.lock

# ------------------------------
